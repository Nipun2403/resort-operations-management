<Project>
  <PropertyGroup>
    <AnalysisLevel>latest-All</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Ignore the missing XML comments warning for now to avoid thousands of trivial errors -->
    <!-- NU1902: suppress moderate-severity NuGet vulnerability warnings for MailKit/MimeKit
         (GHSA-9j88-vvj5-vhgr = NTLM open-redirect; not applicable because we use plain SMTP only)
         (GHSA-g7hc-96xr-gvvx = MimeKit moderate advisory) -->
    <NoWarn>$(NoWarn);CS1591;1591;CA1062;CA2007;CA1707;CA1819;CA1056;CA1825;CA1002;CA1304;CA1311;CA1862;CA2227;CA1860;CA1307;CA1725;CA1515;CA1305;CA1848;CA1030;CA1031;CA1050;CA2201;NU1902;CA1873</NoWarn>
  </PropertyGroup>
</Project>
